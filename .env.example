# TradeBot local runtime configuration
#
# Copy this file to .env and fill secrets locally.
# Never commit .env, API keys, API secrets, authorization headers, or vault exports.

# DeepSeek is the only LLM adapter currently wired into the TypeScript runtime.
# Explicit CLI authorization is still required with: --llm deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1000
TRADEBOT_LESSON_REVIEW_DB_PATH=tradebot-lesson-reviews.sqlite

# Binance credentials are currently used only by signed read-only reconciliation.
# The TypeScript runtime has no exchange-write adapter.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Local Paper Account identifiers are passed through CLI flags.
# Example:
# npm run backtest:ts -- paper-cycle --paper-db data/paper.db --account-id paper:main

# The recommended local Paper workspace needs no secrets:
# npm run dev:paper
#
# It creates ignored files under data/local-paper-workspace, binds Web and API
# to 127.0.0.1, injects an ephemeral development Operator Token into Vite, and
# uses an explicitly labelled backend fixture market. It never enables an
# exchange write path.
